<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modern Store - E-Commerce</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Header / Navigation -->
    <header class="navbar">
        <div class="logo">ShopModern</div>
        <nav>
            <a href="#home">Home</a>
            <a href="#shop">Shop</a>
            <a href="#about">About</a>
            <a href="#contact">Contact</a>
        </nav>
        <div class="cart-icon">
            🛒 <span id="cart-count">0</span>
        </div>
    </header>

    <!-- Hero Section -->
    <section id="home" class="hero">
        <div class="hero-content">
            <h1>Elevate Your Daily Routine</h1>
            <p>Discover minimalist, high-quality products designed for your lifestyle.</p>
            <a href="#shop" class="btn">Shop Collection</a>
        </div>
    </section>

    <!-- Product Catalog Section -->
    <section id="shop" class="products-section">
        <h2>Featured Products</h2>
        <div class="product-grid">
            
            <!-- Product 1 -->
            <div class="product-card">
                <div class="product-image" style="background-color: #f0f0f0;"></div>
                <h3>Minimalist Ceramic Mug</h3>
                <p class="price">$24.00</p>
                <button class="add-to-cart">Add to Cart</button>
            </div>

            <!-- Product 2 -->
            <div class="product-card">
                <div class="product-image" style="background-color: #e5e5e5;"></div>
                <h3>Indoor Succulent Planter</h3>
                <p class="price">$18.50</p>
                <button class="add-to-cart">Add to Cart</button>
            </div>

            <!-- Product 3 -->
            <div class="product-card">
                <div class="product-image" style="background-color: #f0f0f0;"></div>
                <h3>Ergonomic Desk Mat</h3>
                <p class="price">$32.00</p>
                <button class="add-to-cart">Add to Cart</button>
            </div>

            <!-- Product 4 -->
            <div class="product-card">
                <div class="product-image" style="background-color: #e5e5e5;"></div>
                <h3>Wireless Gaming Headset</h3>
                <p class="price">$89.99</p>
                <button class="add-to-cart">Add to Cart</button>
            </div>

        </div>
    </section>

    <!-- Footer -->
    <footer>
        <p>&copy; 2026 ShopModern. All rights reserved.</p>
    </footer>

</body>
</html>
